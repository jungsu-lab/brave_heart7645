---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Props = {
	readonly project: CollectionEntry<'projects'>;
};

export async function getStaticPaths() {
	const projects = await getCollection('projects');

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
const projectCollections = [
	{ tag: '딸기', slug: 'strawberry', backLabel: '← 딸기 프로젝트 전체 보기', relatedTitle: '딸기 프로젝트의 다른 기록' },
	{ tag: 'LG에이머스', slug: 'lg-aimers', backLabel: '← LG Aimers 프로젝트 전체 보기', relatedTitle: 'LG Aimers 여정의 다른 기록' },
];
const activeCollection =
	projectCollections.find((collection) => project.data.tags.includes(collection.tag)) ?? null;
const relatedProjects = activeCollection
	? (await getCollection('projects'))
			.filter(
				(candidate) =>
					candidate.id !== project.id && candidate.data.tags.includes(activeCollection.tag),
			)
			.sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf())
			.slice(0, 4)
	: [];
const projectStatusLabels: Record<string, string> = {
	Active: '운영 중',
	Complete: '완료',
	Study: '실험 중',
};
---

<BaseLayout title={`jungsu blog | ${project.data.title}`} description={project.data.description}>
	<article>
		{activeCollection && <a class="back-link" href={`/projects/${activeCollection.slug}/`}>{activeCollection.backLabel}</a>}
		<header>
			<p class="eyebrow">프로젝트</p>
			<h1>{project.data.title}</h1>
			<p class="lede">{project.data.description}</p>
			<p class="meta">
				<time datetime={project.data.date.toISOString()}>
					{project.data.date.toLocaleDateString('ko-KR', {
						month: 'long',
						day: 'numeric',
						year: 'numeric',
					})}
				</time>
				{' · '}
				{projectStatusLabels[project.data.status] ?? project.data.status}
			</p>
			<p class="tags-line">역할: {project.data.role}</p>
			<p class="tags-line">스택: {project.data.stack.join(', ')}</p>
			<p class="tags-line">태그: {project.data.tags.join(', ')}</p>
		</header>
		<Content />
		{
			activeCollection && relatedProjects.length > 0 && (
				<section class="strawberry-related" aria-labelledby="related-title">
					<p class="eyebrow">Continue reading</p>
					<h2 id="related-title">{activeCollection.relatedTitle}</h2>
					<ul class="strawberry-related__grid">
						{relatedProjects.map((relatedProject) => (
							<li>
								<a href={`/projects/${relatedProject.id}/`}>{relatedProject.data.title}</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</article>
</BaseLayout>
